         // v26: single place where an enemy is built and level-scaled, so every spawn
         // path (spawner, wasp packs, boss reinforcements) ramps identically.
+        // v27.2 (owner request): a small HP bar floats over every non-boss enemy.
+        // One sprite per enemy (1 draw call), redrawn only when hp crosses a 5% step,
+        // so there is zero per-frame cost. Bosses keep the big top-screen bar.
+        function attachHpBar(enemy) {
+            try {
+                const cv = document.createElement('canvas');
+                cv.width = 64; cv.height = 10;
+                const tex = new THREE.CanvasTexture(cv);
+                tex.minFilter = THREE.LinearFilter; tex.generateMipmaps = false; // tiny NPOT canvas
+                const mat = new THREE.SpriteMaterial({ map: tex, transparent: true, depthWrite: false });
+                const spr = new THREE.Sprite(mat);
+                const s = (enemy.typeData && enemy.typeData.size) || 1;
+                spr.scale.set(2.4, 0.375, 1);
+                spr.position.set(0, s * 2.2 + 0.8, 0);
+                enemy.mesh.add(spr);
+                enemy.hpBar = { spr, mat, tex, cv, drawn: -2 };
+                updateHpBar(enemy);
+            } catch (e) { /* bars are cosmetic — never block a spawn */ }
+        }
+        function updateHpBar(enemy) {
+            const b = enemy.hpBar;
+            if (!b) return;
+            const pct = Math.max(0, Math.min(1, enemy.hp / enemy.maxHp));
+            const bucket = Math.round(pct * 20) / 20; // redraw at 5% steps — crisp + cheap
+            if (bucket === b.drawn) return;
+            b.drawn = bucket;
+            const ctx = b.cv.getContext('2d');
+            ctx.clearRect(0, 0, 64, 10);
+            ctx.fillStyle = 'rgba(8, 12, 20, 0.85)';
+            ctx.fillRect(0, 0, 64, 10);
+            ctx.fillStyle = pct > 0.5 ? '#22c55e' : pct > 0.25 ? '#eab308' : '#ef4444';
+            ctx.fillRect(1, 1, Math.max(0, 62 * pct), 8);
+            b.tex.needsUpdate = true;
+        }
